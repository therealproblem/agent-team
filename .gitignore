# Upstream JLPT data — fetch via scripts/seed-srs.ts, not source-controlled
data/

# Notes vault — agent output, personal data. Override with AGENTS_TEAM_VAULT_PATH
# if you'd rather point at your real Obsidian vault.
vault/

# Legacy file:// renders folder — migrated to the Next.js server's content/v/.
# Kept ignored so any stray writes stay out of git.
renders/

# Canonical export root for write_export_pdf. The Next.js server serves
# these at /p/<slug>.pdf via a route handler at .pi/server/app/p/[slug]/
# that reads from disk at request time (the prior public/p symlink design
# broke under `next start` because Next caches its public-files manifest
# at build time). Override the root with AGENTS_TEAM_EXPORT_PATH.
exports/

# Next.js + Nextra app — install deps, build cache, and runtime artifacts.
.pi/server/node_modules/
.pi/server/.next/
.pi/server/next-env.d.ts
*.tsbuildinfo
# Runtime-generated presentation artifacts (URL date-slug paths).
.pi/server/content/v/*.mdx
# Transient export-HTML staging — written, rendered to PDF, then deleted.
# Retained on Chrome failure for manual recovery.
.pi/server/.export-tmp/

# Local secrets — copy .env.example to .env and fill in. Never commit .env.
.env
.env.local

# Pi runtime state (sessions, SRS deck progress, meta-logs)
.pi/state/
.pi/sessions/
.pi/meta-logs/

# Pi-managed extension artifacts
.pi/extensions/**/dist/
.pi/extensions/**/node_modules/

# Pi-installed npm packages (declared in .pi/settings.json; restored via `pi install`)
.pi/npm/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
