# Upstream JLPT data — fetch via scripts/seed-srs.ts, not source-controlled
data/

# Notes vault — agent output, personal data. Override with AGENTS_TEAM_VAULT_PATH
# if you'd rather point at your real Obsidian vault.
vault/

# Safety net for stray vault content that lands outside `vault/`. The board
# extension writes cards to `<vaultRoot>/projects/<slug>/board/...` and
# `<vaultRoot>` resolves to `<repo>/vault` by default — there should never
# be a `projects/` directory at the repo root. If something (a hand-edited
# file, an agent with a misconfigured vault path) writes there anyway, this
# rule keeps it out of git. See commit d11d82c for the case that prompted it.
/projects/

# Generated MDX renders — runtime content read by Nextra.
renders/

# Canonical export root for write_export_pdf. The Next.js server serves
# these at /p/<slug>.pdf via a route handler at .pi/server/app/p/[slug]/
# that reads from disk at request time (the prior public/p symlink design
# broke under `next start` because Next caches its public-files manifest
# at build time). Override the root with AGENTS_TEAM_EXPORT_PATH.
exports/

# Next.js + Nextra app — install deps, build cache, and runtime artifacts.
.pi/server/node_modules/
.pi/server/.next/
.pi/server/next-env.d.ts
*.tsbuildinfo
# Legacy MDX location (now migrated to root renders/). Kept ignored in case
# of stray writes during migration or manual edits.
.pi/server/content/v/
# Runtime-generated presentation artifacts (URL date-slug paths) and any
# images/assets the server writes under public/p for them.
.pi/server/public/p/
# Transient export-HTML staging — written, rendered to PDF, then deleted.
# Retained on Chrome failure for manual recovery.
.pi/server/.export-tmp/
# Log files anywhere in the tree (dev-server logs, Tailwind native-binary
# fallback noise, ad-hoc debug logs, etc.).
*.log

# Local secrets — copy .env.example to .env and fill in. Never commit .env.
.env
.env.local

# Pi runtime state (sessions, SRS deck progress, meta-logs)
.pi/state/
.pi/sessions/
.pi/meta-logs/

# Pi-managed extension artifacts
.pi/extensions/**/dist/
.pi/extensions/**/node_modules/
.pi/extensions/node_modules

# Pi-installed npm packages (declared in .pi/settings.json; restored via `pi install`)
.pi/npm/

# CodeGraph per-developer index (rebuilt locally via `codegraph index .` / auto-sync)
.codegraph/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
