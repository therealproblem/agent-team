# Copy this to `.env` (gitignored) and fill in real values.
# Source it before running tools that need these vars:
#
#   set -a; source .env; set +a   # POSIX-ish; works in zsh/bash
#
# or use a tool like direnv to auto-source on cd into this repo.

# ---- agents-team paths -----------------------------------------------------
# Override the default project-root vault location if you want notes to land
# in your real Obsidian vault elsewhere on disk.
# AGENTS_TEAM_VAULT_PATH=/Users/you/Obsidian/your-vault
